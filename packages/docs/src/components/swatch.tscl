{{-- A nested island: its hue input follows the parent; its pinned state is its own. --}}
@input hue: number

<script>
  let pinned = state(false)
</script>

<span class="swatch" [style]="'--hue: ' + hue"><b class="swatch-hue">{{ hue }}°</b> <button type="button" class="swatch-pin" (click)="pinned = !pinned" [aria-pressed]="pinned ? 'true' : 'false'">{{ pinned ? 'Pinned' : 'Pin' }}</button></span>
